xlab = "Iteration", ylab = "Value")
}
par(mfrow = c(2,2))
for (i in 1:min(4, ncol(samples_post))) {
hist(samples_post[,i],
main = paste("Posterior of lambda", i),
xlab = "Value", breaks = 30)
}
ranked <- order(posterior_means, decreasing = TRUE)
