Data <- as.matrix(read.csv("C:/Users/USER/Downloads/win_matrix (1).csv", header = TRUE))
N <- nrow(Data)
log_posterior <- function(lambda, Y) {
N <- nrow(Y)
loglik <- 0
for (i in 1:(N-1)) {
for (j in (i+1):N) {
nij <- Y[i,j] + Y[j,i]
loglik <- loglik +
Y[i,j] * lambda[i] +
Y[j,i] * lambda[j] -
nij * log(exp(lambda[i]) + exp(lambda[j]))
}
}
logprior <- sum(dnorm(lambda[-1], 0, 10, log = TRUE))
return(loglik + logprior)
}
mcmc_metropolis <- function(Y, n_iter = 10000, step_size = 0.1) {
N <- nrow(Y)
# Initialize parameters
lambda_current <- rep(0, N)
# Store samples
samples <- matrix(0, nrow = n_iter, ncol = N)
accept <- 0
for (t in 1:n_iter) {
# Propose new lambda
lambda_proposal <- lambda_current + rnorm(N, 0, step_size)
# Fix identifiability constraint
lambda_proposal[1] <- 0
# Compute log posterior
log_post_current <- log_posterior(lambda_current, Y)
log_post_proposal <- log_posterior(lambda_proposal, Y)
# Acceptance probability
log_alpha <- log_post_proposal - log_post_current
if (log(runif(1)) < log_alpha) {
lambda_current <- lambda_proposal
accept <- accept + 1
}
samples[t, ] <- lambda_current
}
cat("Acceptance rate:", accept / n_iter, "\n")
return(samples)
}
par(mfrow = c(2,2))
