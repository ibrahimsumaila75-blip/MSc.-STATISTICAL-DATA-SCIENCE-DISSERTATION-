#############################################################
# MSc Statistical Data Science Dissertation
#
# Title:
# Prediction of Chronological Age Using NHANES Biomarkers:
# A Comparison of Linear Regression, Ridge, LASSO
# and Elastic Net Regression
#
# Student: Ibrahim Sumaila
# University: University of Birmingham
#
# Script 1:
# Data Import and Merging
#############################################################
#============================================================
# SECTION 1: Clear Workspace
#============================================================
rm(list = ls())
#============================================================
# SECTION 2: Load Required Packages
#============================================================
library(haven)
library(dplyr)
#============================================================
# SECTION 3: Set Working Directory
#============================================================
setwd("C:/Users/USER/Desktop/MSC DISSERTATION/DATA/RAW")
getwd()
#============================================================
# SECTION 4: Import Function
#============================================================
import_cycle <- function(cycle_name){
base_path <- file.path(
"C:/Users/USER/Desktop/MSC DISSERTATION/DATA/RAW",
cycle_name
)
#-------------------------
# DEMOGRAPHICS
#-------------------------
demo <- read_xpt(
list.files(
file.path(base_path,"DEMO"),
pattern = "DEMO",
full.names = TRUE
)
)
#-------------------------
# BLOOD PRESSURE
#-------------------------
bp <- read_xpt(
list.files(
file.path(base_path,"EXAM"),
pattern = "BPX",
full.names = TRUE
)
)
bp_clean <- bp %>%
mutate(
SBP_mean = rowMeans(
select(., BPXSY1:BPXSY3),
na.rm = TRUE
),
DBP_mean = rowMeans(
select(., BPXDI1:BPXDI3),
na.rm = TRUE
)
) %>%
select(
SEQN,
SBP_mean,
DBP_mean
)
#-------------------------
# BODY MEASUREMENTS
#-------------------------
bmx <- read_xpt(
list.files(
file.path(base_path,"EXAM"),
pattern = "BMX",
full.names = TRUE
)
)
bmx_clean <- bmx %>%
select(
SEQN,
BMXBMI,
BMXWT,
BMXHT,
BMXWAIST
)
#-------------------------
# LABORATORY FILES
#-------------------------
lab_path <- file.path(base_path,"LAB")
glu <- read_xpt(
list.files(
lab_path,
pattern="GLU",
full.names=TRUE)
) %>%
select(SEQN,LBXGLU)
tchol <- read_xpt(
list.files(
lab_path,
pattern="TCHOL",
full.names=TRUE)
) %>%
select(SEQN,LBXTC)
hdl <- read_xpt(
list.files(
lab_path,
pattern="HDL",
full.names=TRUE)
) %>%
select(SEQN,LBDHDD)
bio <- read_xpt(
list.files(
lab_path,
pattern="BIOPRO",
full.names=TRUE)
) %>%
select(
SEQN,
LBXSAL,
LBXSCR,
LBXSGL,
LBXSTP,
LBXSUA,
LBXSBU
)
#-------------------------
# MERGE DATASETS
#-------------------------
data <- demo %>%
left_join(bp_clean,by="SEQN") %>%
left_join(bmx_clean,by="SEQN") %>%
left_join(glu,by="SEQN") %>%
left_join(tchol,by="SEQN") %>%
left_join(hdl,by="SEQN") %>%
left_join(bio,by="SEQN")
data$cycle <- cycle_name
return(data)
}
#============================================================
# SECTION 5: Import All NHANES Cycles
#============================================================
data_2009 <- import_cycle("2009_2010")
data_2011 <- import_cycle("2011_2012")
data_2013 <- import_cycle("2013_2014")
data_2015 <- import_cycle("2015_2016")
data_2017 <- import_cycle("2017_2018")
#============================================================
# SECTION 6: Keep Common Variables
#============================================================
common_vars <- Reduce(
intersect,
list(
names(data_2009),
names(data_2011),
names(data_2013),
names(data_2015),
names(data_2017)
)
)
data_2009 <- data_2009[, common_vars]
data_2011 <- data_2011[, common_vars]
data_2013 <- data_2013[, common_vars]
data_2015 <- data_2015[, common_vars]
data_2017 <- data_2017[, common_vars]
#============================================================
# SECTION 7: Merge All Cycles
#============================================================
master_data <- bind_rows(
data_2009,
data_2011,
data_2013,
data_2015,
data_2017
)
#============================================================
# SECTION 8: Check Final Dataset
#============================================================
cat("Master dataset dimensions:\n")
dim(master_data)
cat("\nVariables:\n")
names(master_data)
summary(master_data$RIDAGEYR)
table(master_data$cycle)
#============================================================
# SECTION 9: Save Dataset
#============================================================
saveRDS(
master_data,
file="../CLEAN/master_data.rds"
)
